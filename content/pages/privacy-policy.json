              }
            }
          },
          {
            "type": "text",
            "props": {
              "content": "We may update this Privacy Policy from time to time. Any changes will be reflected by the \"Last Updated\" date above.",
              "variant": "body",
              "align": "left",
              "color": "muted",
              "transform": "none",
              "lineHeight": 1.6
            },
