          },
          {
            "type": "text",
            "props": {
              "content": "8. Contact Us",
              "variant": "h2",
              "align": "left",
              "color": "foreground",
              "transform": "none",
              "fontSize": 24,
              "lineHeight": 1.2,
              "letterSpacing": 0
            },
