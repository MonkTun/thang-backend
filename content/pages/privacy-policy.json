              }
            }
          },
          {
            "type": "text",
            "props": {
              "content": "7. Changes to This Policy",
              "variant": "h2",
              "align": "left",
              "color": "foreground",
              "transform": "none",
              "fontSize": 24,
              "lineHeight": 1.2,
              "letterSpacing": 0
            },
            "id": "blk_ca29d5be",
            "layout": {
